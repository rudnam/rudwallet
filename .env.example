# Local development: cp .env.example .env, then docker compose up -d --build.
# Never commit .env. Production doesn't use this file: its settings (the same
# variables) are in AWS Parameter Store (README.md, "Production").
COMPOSE_FILE=docker-compose.yml:deploy/local.yml

# Any value works locally.
POSTGRES_PASSWORD=local-dev-only

# Public address, used in links and redirect URIs (production: wallet.rudnam.com).
DOMAIN=localhost

# Everything below is optional locally; set a feature's variables only to try it.

# Set to false to stop new accounts being created.
ALLOW_SIGNUP=true

# Email automation (docs/email.md). Users forward payment emails to
# pay-<token>@INBOUND_DOMAIN; a Cloudflare Email Worker posts them to the app.
# INBOUND_SECRET: long random string, e.g. from: openssl rand -base64 32
INBOUND_DOMAIN=
INBOUND_SECRET=

# Encrypts what users save in the app, such as their own Claude API keys
# (Settings -> Claude). Without it, they can't save one. Long random string,
# e.g. from: openssl rand -base64 32. Keep it safe and don't change it: if
# it's lost or changed, users have to add their keys again.
SECRETS_KEY=

# Optional: lets Claude read payment emails no built-in rule knows.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: "Continue with Google" on the sign-in page (README.md, "Sign in
# with Google"). The redirect URI to register is https://DOMAIN/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: email new accounts a link to confirm their address. Any SMTP
# provider; port 587 (STARTTLS) or 465. Links point to https://DOMAIN.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Wallet <no-reply@example.com>

# Optional: the Android app (android/README.md). Sign in with Google in the app returns to this package.
# Fingerprints: your upload key's SHA-256, plus Play's app signing key, comma-separated.
ANDROID_PACKAGE=
ANDROID_CERT_FINGERPRINTS=
