# Copy to .env and fill in. Never commit .env.

# How visitors reach the app: the core stack plus one file from deploy/.
#   This machine only: COMPOSE_FILE=docker-compose.yml:deploy/local.yml
#   Cloudflare Tunnel: COMPOSE_FILE=docker-compose.yml:deploy/cloudflare.yml
#   Caddy (public IP): COMPOSE_FILE=docker-compose.yml:deploy/caddy.yml
COMPOSE_FILE=docker-compose.yml:deploy/local.yml

# Public address of the app (not used by deploy/local.yml).
DOMAIN=app.example.com

# Long random string, e.g. from: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Cloudflare Tunnel only: the tunnel token (it works like a password).
TUNNEL_TOKEN=

# Caddy only: Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=

# Optional: run a published image instead of building here, e.g.
# APP_IMAGE=ghcr.io/you/your-app:3f2c1ab   (see docs/deploy.md)
APP_IMAGE=

# Set to false to stop new accounts being created.
ALLOW_SIGNUP=true

# Email automation (docs/email.md). Users forward payment emails to
# pay-<token>@INBOUND_DOMAIN; a Cloudflare Email Worker posts them to the app.
# INBOUND_SECRET: long random string, e.g. from: openssl rand -base64 32
INBOUND_DOMAIN=
INBOUND_SECRET=

# Optional: lets Claude read payment emails no built-in rule knows.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
