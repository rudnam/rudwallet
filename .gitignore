.env
*.sql.gz
/backups/

# Browser test deps and output (see verify.sh)
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/

# Frontend deps and build output (dist/.gitkeep stays so go:embed always has a folder)
web/node_modules/
web/dist/*
!web/dist/.gitkeep
# The web app as built for the Android app (npm run android)
web/dist-android/

# Android: generated build output and, above all, the signing key
android/**/build/
android/.gradle/
*.keystore
*.jks
android/signing-key.txt
android/*.apk
android/*.aab
android/*.idsig
# The APK the server offers for download (ANDROID_APK). The folder itself is
# kept, so Docker doesn't create it as root when it mounts it.
/downloads/*
!/downloads/.gitkeep
