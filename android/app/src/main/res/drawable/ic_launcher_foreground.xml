<?xml version="1.0" encoding="utf-8"?>
<!-- The wallet from web/public/icon.svg, in its coordinates, on the 108dp adaptive-icon canvas.
     Vector drawables can't blur, so the SVG's soft shadows are left out. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="672" android:viewportHeight="672">
    <group android:translateX="80" android:translateY="80">
        <!-- Back of the wallet, behind the cards -->
        <path android:fillColor="#6A2A12" android:pathData="M152,176 H360 Q396,176 396,212 V346 Q396,382 360,382 H152 Q116,382 116,346 V212 Q116,176 152,176 Z" />
        <!-- White card -->
        <group android:rotation="-5" android:pivotX="250" android:pivotY="200">
            <path android:pathData="M164,134 H332 Q348,134 348,150 V244 Q348,260 332,260 H164 Q148,260 148,244 V150 Q148,134 164,134 Z">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="linear" android:startX="0" android:startY="134" android:endX="0" android:endY="260">
                        <item android:offset="0" android:color="#FFFBFAF6" />
                        <item android:offset="1" android:color="#FFEBE6D9" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>
        <!-- Blue card with its chip -->
        <group android:rotation="4" android:pivotX="280" android:pivotY="210">
            <path android:pathData="M194,146 H362 Q378,146 378,162 V256 Q378,272 362,272 H194 Q178,272 178,256 V162 Q178,146 194,146 Z">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="linear" android:startX="0" android:startY="146" android:endX="0" android:endY="272">
                        <item android:offset="0" android:color="#FF4A6EA6" />
                        <item android:offset="1" android:color="#FF2B4677" />
                    </gradient>
                </aapt:attr>
            </path>
            <path android:fillColor="#8CFFFFFF" android:pathData="M206,176 H232 Q238,176 238,182 V198 Q238,204 232,204 H206 Q200,204 200,198 V182 Q200,176 206,176 Z" />
        </group>
        <!-- Front pocket -->
        <path android:pathData="M140,216 H372 Q410,216 410,254 V368 Q410,406 372,406 H140 Q102,406 102,368 V254 Q102,216 140,216 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="0" android:startY="216" android:endX="0" android:endY="406">
                    <item android:offset="0" android:color="#FFC4683F" />
                    <item android:offset="1" android:color="#FF933F20" />
                </gradient>
            </aapt:attr>
        </path>
        <path android:strokeColor="#29FFFFFF" android:strokeWidth="2.5" android:pathData="M146,236 H366 Q390,236 390,260 V362 Q390,386 366,386 H146 Q122,386 122,362 V260 Q122,236 146,236 Z" />
    </group>
</vector>
