<?xml version="1.0" encoding="utf-8"?>
<!-- One budget in the Budgets widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:singleLine="true"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/meter"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:max="1000"
        android:maxHeight="4dp"
        android:minHeight="4dp"
        android:progress="700"
        android:progressDrawable="@drawable/widget_meter" />

    <ProgressBar
        android:id="@+id/meter_warn"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:max="1000"
        android:maxHeight="4dp"
        android:minHeight="4dp"
        android:progressDrawable="@drawable/widget_meter_warn"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/meter_over"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:max="1000"
        android:maxHeight="4dp"
        android:minHeight="4dp"
        android:progress="1000"
        android:progressDrawable="@drawable/widget_meter_over"
        android:visibility="gone" />
</LinearLayout>
