<?xml version="1.0" encoding="utf-8"?>
<!-- This month. The texts here are the widget picker's preview; Widgets.month() fills in the real ones. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/eyebrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.08"
            android:singleLine="true"
            android:text="@string/widget_preview_month"
            android:textAllCaps="true"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_add_circle"
            android:contentDescription="@string/widget_add"
            android:padding="8dp"
            android:src="@drawable/widget_plus" />
    </LinearLayout>

    <!-- Takes up any extra height, so the figure sits at the bottom. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/spent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:fontFamily="serif"
            android:singleLine="true"
            android:text="@string/widget_preview_spent"
            android:textColor="@color/widget_text"
            android:textSize="30sp" />

        <ProgressBar
            android:id="@+id/meter"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progress="700"
            android:progressDrawable="@drawable/widget_meter" />

        <ProgressBar
            android:id="@+id/meter_over"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progress="1000"
            android:progressDrawable="@drawable/widget_meter_over"
            android:visibility="gone" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/widget_preview_detail"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/review"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/widget_preview_review"
            android:textColor="@color/widget_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_sign_in"
        android:textColor="@color/widget_text"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
