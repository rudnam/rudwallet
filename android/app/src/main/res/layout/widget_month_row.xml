<?xml version="1.0" encoding="utf-8"?>
<!-- The month widget one row tall (widget_month.xml is the full one): the figure and payments to
     check, and the overall budget's meter under them; from 80dp tall, the label above. The same ids, so Widgets.month() fills in
     either. No line under the figure and no add button: it's for reading at a glance (a tap opens
     the app, and the New record widget adds); the figure turns red when over budget. Hidden until
     drawn, as widget_month.xml explains. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="18dp">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="invisible">

        <!-- Shown from 80dp tall (Widgets.month), where there's room for it. -->
        <TextView
            android:id="@+id/eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/widget_spent_this_month"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/spent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:singleLine="true"
                android:textColor="@color/widget_text"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/review"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/widget_dot"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:textColor="@color/widget_attention"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- The overall budget's meter, as in widget_month.xml: one bar per state. -->
        <ProgressBar
            android:id="@+id/meter"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progress="700"
            android:progressDrawable="@drawable/widget_meter" />

        <ProgressBar
            android:id="@+id/meter_warn"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progressDrawable="@drawable/widget_meter_warn"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/meter_over"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progress="1000"
            android:progressDrawable="@drawable/widget_meter_over"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
