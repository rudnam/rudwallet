<?xml version="1.0" encoding="utf-8"?>
<!-- The month widget one row tall (widget_month.xml is the full one): the figure, what it means
     today under it, payments to check, and the add button, side by side. The same ids, so
     Widgets.month() fills in either. No meter: there's no room for it; the line under the figure
     turns red when over budget. Hidden until drawn, as widget_month.xml explains. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/spent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:singleLine="true"
                android:textColor="@color/widget_text"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:singleLine="true"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/review"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/widget_dot"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="@color/widget_attention"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/add"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_add_circle"
        android:contentDescription="@string/widget_add"
        android:padding="9dp"
        android:src="@drawable/widget_plus" />
</LinearLayout>
